PORT=5000
NODE_ENV=development
# Render Postgres: use the *Internal* connection string for services in the same region
DATABASE_URL=postgres://user:password@localhost:5432/nitro
# At least 32 characters. Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Comma-separated list of allowed browser origins, or * while developing
FRONTEND_URL=http://localhost:3000
# DATABASE_SSL=false
# OPENF1_BASE_URL=https://api.openf1.org/v1
# NOWPAYMENTS_API_KEY=
# ODDS_API_KEY=
