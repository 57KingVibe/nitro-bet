PORT=5000
NODE_ENV=development
# Render Postgres: use the *Internal* connection string for services in the same region
DATABASE_URL=postgres://user:password@localhost:5432/nitro
# At least 32 characters. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Comma-separated list of allowed browser origins, or * while developing
FRONTEND_URL=http://localhost:3000

# --- product / compliance (all optional; safe defaults) ---
# false = play-money mode: free signup credit, demo market, no real deposits. Keep false until licensed.
# REAL_MONEY_ENABLED=false
# Countries to refuse (ISO codes, comma separated), checked against Cloudflare's CF-IPCountry header
# BLOCKED_COUNTRIES=
# Enables /api/admin (create / close / settle / void markets). 24+ random characters. Unset = admin API off.
# ADMIN_API_KEY=
# MIN_AGE=18
# MIN_STAKE_MINOR=100
# MAX_STAKE_MINOR=50000
# SIGNUP_CREDIT_MINOR=100000
# DATABASE_SSL=false
# OPENF1_BASE_URL=https://api.openf1.org/v1
# LEADERBOARD_MIN_SETTLED=1
# WEEKLY_PRIZE_ENABLED=false   # only changes UI wording; there is no payout code. Ask a lawyer before turning prizes on.
